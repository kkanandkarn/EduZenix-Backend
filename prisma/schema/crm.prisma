model CrmUniversity {
    id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
    aisheCode           String?
    name                String
    state               String
    district            String
    website             String?
    yearOfEstablishment Int?
    location            InstitutionLocation?
    pocName             String?
    pocEmail            String?
    pocContact          String?
    address             String?              @db.Text
    tenantId            String?              @db.Uuid
    tenant              Tenants?             @relation(fields: [tenantId], references: [id])
    assignedTo          String?              @db.Uuid
    assignedUser        Users?               @relation("CrmUniversityAssignedTo", fields: [assignedTo], references: [id])
    isOnboarded         Boolean              @default(false)
    status              CrmStatus
    remarks             String?
    updatedBy           String?              @db.Uuid
    updator             Users?               @relation("CrmUniversityUpdatedBy", fields: [updatedBy], references: [id])
    updatedAt           DateTime?
}

model CrmCollege {
    id                  String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
    aisheCode           String?
    name                String
    state               String
    district            String
    website             String?
    yearOfEstablishment Int?
