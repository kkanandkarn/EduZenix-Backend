    assignedTo          String?                   @db.Uuid
    assignedUser        Users?                    @relation("CrmCollegeAssignedTo", fields: [assignedTo], references: [id])
    isOnboarded         Boolean                   @default(false)
    status              CrmStatus
    remarks             String?
    updatedBy           String?                   @db.Uuid
    updator             Users?                    @relation("CrmCollegeUpdatedBy", fields: [updatedBy], references: [id])
    updatedAt           DateTime?
}

