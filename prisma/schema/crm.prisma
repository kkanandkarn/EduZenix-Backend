model CrmSchool {
    id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
    udiseCode    String?
    name         String?
    state        String?
    district     String?
    block        String?
    cluster      String?
    village      String?
    panchayat    String?
    location     InstitutionLocation?
    pocName      String?
    pocEmail     String?
    pocContact   String?
    address      String?              @db.Text
    tenantId     String?              @db.Uuid
    tenant       Tenants?             @relation(fields: [tenantId], references: [id])
    assignedTo   String?              @db.Uuid
    assignedUser Users?               @relation("CrmSchoolAssignedTo", fields: [assignedTo], references: [id])
    isOnboarded  Boolean              @default(false)
    status       CrmStatus            @default(PENDING)
    remarks      String?
    createdBy    String?              @db.Uuid
    creator      Users?               @relation("CrmSchoolCreatedBy", fields: [createdBy], references: [id])
    updatedBy    String?              @db.Uuid
    updator      Users?               @relation("CrmSchoolUpdatedBy", fields: [updatedBy], references: [id])
    updatedAt    DateTime?
}
