model CrmUniversity {
    id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
    aisheCode           String               @unique
    name                String
    state               String
    district            String
    website             String?
    yearOfEstablishment Int?
    location            InstitutionLocation?
    pocName             String?
    pocEmail            String?
    pocContact          String?
    address             String?              @db.Text
    tenantId            String?              @db.Uuid
    tenant              Tenants?             @relation(fields: [tenantId], references: [id])
    assignedTo          String?              @db.Uuid
    assignedUser        Users?               @relation("CrmUniversityAssignedTo", fields: [assignedTo], references: [id])
    isOnboarded         Boolean              @default(false)
    status              CrmStatus            @default(PENDING)
    remarks             String?
    createdBy           String?              @db.Uuid
    creator             Users?               @relation("CrmUniversityCreatedBy", fields: [createdBy], references: [id])
    createdAt           DateTime             @default(now())
    updatedBy           String?              @db.Uuid
    updator             Users?               @relation("CrmUniversityUpdatedBy", fields: [updatedBy], references: [id])
    updatedAt           DateTime?
}

