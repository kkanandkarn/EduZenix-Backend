# Copy to .env.development (or .env.<NODE_ENV>) and fill in real values.
# prisma.config.ts loads .env.<NODE_ENV>.local, then .env.<NODE_ENV>, then .env.

# ADMIN
ADMIN_ACCESS_KEY=""


# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/eduzenix?schema=public"

# GENERAL
PORT="8000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# URLS
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# JWT CONFIG
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# AWS CONFIG
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY=""
AWS_SECRET_KEY=""

# SES CONFIG
SES_EMAIL=""

# GOOGLE CONFIG
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
